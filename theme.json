{
  "$schema": "https://schemas.wp.org/wp/6.4/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "paper", "name": "Paper", "color": "#f5f2eb" },
        { "slug": "surface", "name": "Surface", "color": "#ffffff" },
        { "slug": "ink", "name": "Ink", "color": "#171916" },
        { "slug": "muted", "name": "Muted", "color": "#5f655d" },
        { "slug": "line", "name": "Line", "color": "#d7d8d1" },
        { "slug": "accent", "name": "Accent", "color": "#365f45" }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "rem", "em", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "20", "size": "0.75rem", "name": "XS" },
        { "slug": "30", "size": "1rem", "name": "S" },
        { "slug": "40", "size": "clamp(1.25rem, 1rem + 1vw, 2rem)", "name": "M" },
        { "slug": "50", "size": "clamp(2rem, 1.4rem + 2vw, 4rem)", "name": "L" },
        { "slug": "60", "size": "clamp(3rem, 2rem + 4vw, 7rem)", "name": "XL" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "System Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        },
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "Iowan Old Style, Baskerville, Times New Roman, serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "clamp(1.2rem, 1.1rem + 0.5vw, 1.5rem)", "name": "Large" },
        { "slug": "x-large", "size": "clamp(2rem, 1.35rem + 3vw, 4rem)", "name": "Extra Large" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "1rem",
      "lineHeight": "1.65"
    },
    "elements": {
      "button": {
        "border": { "radius": "999px" },
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "var(--wp--preset--color--surface)"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1.25rem",
            "bottom": "0.75rem",
            "left": "1.25rem"
          }
        },
        "typography": { "fontWeight": "650" }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.05"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--accent)" }
      }
    }
  }
}
